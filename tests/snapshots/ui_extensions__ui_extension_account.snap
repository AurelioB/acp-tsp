---
source: tests/ui_extensions.rs
expression: "normal[\"dock\"]"
---
{
  "id": "dock",
  "k": "col",
  "c": [
    {
      "id": "dock.editor",
      "k": "col",
      "p": {
        "key": "editor",
        "role": "omp.editor"
      },
      "c": [
        {
          "id": "dock.editor.line",
          "k": "row",
          "p": {
            "key": "line",
            "role": "omp.composer.line",
            "align": "start",
            "gap": "sm"
          },
          "c": [
            {
              "id": "dock.editor.line.ed",
              "k": "editor",
              "p": {
                "key": "ed",
                "text": "",
                "cursor": 0,
                "placeholder": "Message Agent…",
                "maxLines": 18,
                "readonly": false,
                "sendable": true
              }
            }
          ]
        },
        {
          "id": "dock.editor.bar",
          "k": "row",
          "p": {
            "key": "bar",
            "role": "omp.composer.bar",
            "gap": "sm",
            "align": "center"
          },
          "c": [
            {
              "id": "dock.editor.bar.model",
              "k": "row",
              "p": {
                "key": "model",
                "role": "omp.composer.model",
                "gap": "xs",
                "align": "center",
                "title": "Switch model",
                "actions": {
                  "click": "click"
                }
              },
              "c": [
                {
                  "id": "dock.editor.bar.model.icon",
                  "k": "icon",
                  "p": {
                    "name": "model",
                    "key": "icon"
                  }
                },
                {
                  "id": "dock.editor.bar.model.name",
                  "k": "text",
                  "p": {
                    "spans": [
                      {
                        "t": "Agent",
                        "s": "statusLineModel"
                      }
                    ],
                    "key": "name"
                  }
                },
                {
                  "id": "dock.editor.bar.model.chev",
                  "k": "icon",
                  "p": {
                    "name": "chev",
                    "key": "chev"
                  }
                }
              ]
            },
            {
              "id": "dock.editor.bar.extras",
              "k": "status",
              "p": {
                "key": "extras",
                "role": "omp.composer.extras",
                "transparent": true,
                "grow": 1
              },
              "c": [
                {
                  "id": "dock.editor.bar.extras.account",
                  "k": "seg",
                  "p": {
                    "text": "ChatGPT Pro",
                    "key": "account",
                    "role": "omp.composer.fact",
                    "priority": 3.0,
                    "actions": {
                      "click": "click"
                    }
                  }
                }
              ]
            },
            {
              "id": "dock.editor.bar.usage",
              "k": "text",
              "p": {
                "text": "0 turns",
                "key": "usage",
                "role": "omp.composer.usage",
                "title": "Usage report",
                "actions": {
                  "click": "click"
                }
              }
            },
            {
              "id": "dock.editor.bar.send",
              "k": "kbd",
              "p": {
                "keys": [
                  "enter"
                ],
                "key": "send",
                "role": "omp.composer.send",
                "title": "Send  Enter",
                "actions": {
                  "click": "click"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
