---
source: tests/ui_view.rs
expression: wire(&model)
---
{
  "main": {
    "id": "main",
    "k": "col",
    "p": {
      "key": "transcript"
    },
    "c": [
      {
        "id": "main.welcome.before",
        "k": "spacer",
        "p": {
          "key": "welcome.before",
          "size": "sm"
        }
      },
      {
        "id": "main.welcome",
        "k": "card",
        "p": {
          "key": "welcome",
          "role": "omp.welcome"
        },
        "c": [
          {
            "id": "main.welcome.lockup",
            "k": "row",
            "p": {
              "key": "lockup",
              "role": "omp.welcome.lockup",
              "align": "center",
              "gap": "md"
            },
            "c": [
              {
                "id": "main.welcome.lockup.glyph",
                "k": "text",
                "p": {
                  "text": "✦",
                  "key": "glyph",
                  "role": "omp.welcome.logo",
                  "tone": "accent",
                  "title": "Agent"
                }
              },
              {
                "id": "main.welcome.lockup.mark",
                "k": "col",
                "p": {
                  "key": "mark",
                  "role": "omp.welcome.mark"
                },
                "c": [
                  {
                    "id": "main.welcome.lockup.mark.wordmark",
                    "k": "text",
                    "p": {
                      "spans": [
                        {
                          "t": "Agent",
                          "s": "strong"
                        }
                      ],
                      "key": "wordmark",
                      "role": "omp.welcome.wordmark"
                    }
                  },
                  {
                    "id": "main.welcome.lockup.mark.version",
                    "k": "text",
                    "p": {
                      "spans": [
                        {
                          "t": "Connecting…",
                          "s": "dim mono"
                        }
                      ],
                      "key": "version",
                      "role": "omp.welcome.version"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "main.welcome.tip",
            "k": "row",
            "p": {
              "key": "tip",
              "role": "omp.welcome.tip",
              "gap": "sm",
              "align": "start"
            },
            "c": [
              {
                "id": "main.welcome.tip.icon",
                "k": "icon",
                "p": {
                  "name": "folder",
                  "key": "icon",
                  "role": "omp.welcome.tip-icon"
                }
              },
              {
                "id": "main.welcome.tip.text",
                "k": "text",
                "p": {
                  "text": "Starting session…  ·  / commands  ·  @ files",
                  "key": "text",
                  "role": "omp.welcome.tip-text"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "main.welcome.after",
        "k": "spacer",
        "p": {
          "key": "welcome.after",
          "size": "sm"
        }
      }
    ]
  },
  "dock": {
    "id": "dock",
    "k": "col",
    "c": [
      {
        "id": "dock.editor",
        "k": "col",
        "p": {
          "key": "editor",
          "role": "omp.editor"
        },
        "c": [
          {
            "id": "dock.editor.line",
            "k": "row",
            "p": {
              "key": "line",
              "role": "omp.composer.line",
              "align": "start",
              "gap": "sm"
            },
            "c": [
              {
                "id": "dock.editor.line.ed",
                "k": "editor",
                "p": {
                  "key": "ed",
                  "text": "",
                  "cursor": 0,
                  "placeholder": "Message Agent…",
                  "maxLines": 18,
                  "readonly": true,
                  "sendable": false
                }
              }
            ]
          },
          {
            "id": "dock.editor.bar",
            "k": "row",
            "p": {
              "key": "bar",
              "role": "omp.composer.bar",
              "gap": "sm",
              "align": "center"
            },
            "c": [
              {
                "id": "dock.editor.bar.model",
                "k": "row",
                "p": {
                  "key": "model",
                  "role": "omp.composer.model",
                  "gap": "xs",
                  "align": "center",
                  "title": "Switch model",
                  "actions": {
                    "click": "click"
                  }
                },
                "c": [
                  {
                    "id": "dock.editor.bar.model.icon",
                    "k": "icon",
                    "p": {
                      "name": "model",
                      "key": "icon"
                    }
                  },
                  {
                    "id": "dock.editor.bar.model.name",
                    "k": "text",
                    "p": {
                      "spans": [
                        {
                          "t": "Agent",
                          "s": "statusLineModel"
                        }
                      ],
                      "key": "name"
                    }
                  },
                  {
                    "id": "dock.editor.bar.model.chev",
                    "k": "icon",
                    "p": {
                      "name": "chev",
                      "key": "chev"
                    }
                  }
                ]
              },
              {
                "id": "dock.editor.bar.extras",
                "k": "status",
                "p": {
                  "key": "extras",
                  "role": "omp.composer.extras",
                  "transparent": true,
                  "grow": 1
                }
              },
              {
                "id": "dock.editor.bar.send",
                "k": "kbd",
                "p": {
                  "keys": [
                    "enter"
                  ],
                  "key": "send",
                  "role": "omp.composer.send",
                  "title": "Send  Enter",
                  "actions": {
                    "click": "click"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "layer": {
    "id": "layer",
    "k": "col",
    "c": [
      {
        "id": "layer.exited",
        "k": "overlay",
        "p": {
          "modal": true,
          "key": "exited",
          "role": "omp.overlay.error",
          "head": "Agent exited"
        },
        "c": [
          {
            "id": "layer.exited.reason",
            "k": "md",
            "p": {
              "text": "Process crashed",
              "key": "reason",
              "role": "omp.error.message"
            }
          },
          {
            "id": "layer.exited.actions",
            "k": "row",
            "p": {
              "key": "actions",
              "role": "omp.error.actions",
              "gap": "sm"
            },
            "c": [
              {
                "id": "layer.exited.actions.restart",
                "k": "row",
                "p": {
                  "key": "restart",
                  "role": "omp.error.action",
                  "gap": "xs",
                  "align": "center",
                  "actions": {
                    "click": "click"
                  }
                },
                "c": [
                  {
                    "id": "layer.exited.actions.restart.label",
                    "k": "text",
                    "p": {
                      "text": "Restart",
                      "key": "label"
                    }
                  },
                  {
                    "id": "layer.exited.actions.restart.key",
                    "k": "kbd",
                    "p": {
                      "keys": [
                        "r"
                      ],
                      "key": "key"
                    }
                  }
                ]
              },
              {
                "id": "layer.exited.actions.quit",
                "k": "row",
                "p": {
                  "key": "quit",
                  "role": "omp.error.action",
                  "gap": "xs",
                  "align": "center",
                  "actions": {
                    "click": "click"
                  }
                },
                "c": [
                  {
                    "id": "layer.exited.actions.quit.label",
                    "k": "text",
                    "p": {
                      "text": "Quit",
                      "key": "label"
                    }
                  },
                  {
                    "id": "layer.exited.actions.quit.key",
                    "k": "kbd",
                    "p": {
                      "keys": [
                        "ctrl",
                        "d"
                      ],
                      "key": "key"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
