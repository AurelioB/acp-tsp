                      "mode": "classic",
                      "palette": {
                        "low": "dim",
                        "mid": "muted",
                        "high": "accent"
                      }
                    }
                  },
                  {
                    "id": "dock.activity.status.working.fill",
                    "k": "row",
                    "p": {
                      "key": "fill",
                      "grow": 1
