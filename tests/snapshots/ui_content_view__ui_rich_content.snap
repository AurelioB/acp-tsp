---
source: tests/ui_content_view.rs
expression: "wire(&model)[\"main\"]"
---
{
  "id": "main",
  "k": "col",
  "p": {
    "key": "transcript"
  },
  "c": [
    {
      "id": "main.welcome.before",
      "k": "spacer",
      "p": {
        "key": "welcome.before",
        "size": "sm"
      }
    },
    {
      "id": "main.welcome",
      "k": "card",
      "p": {
        "key": "welcome",
        "role": "omp.welcome"
      },
      "c": [
        {
          "id": "main.welcome.lockup",
          "k": "row",
          "p": {
            "key": "lockup",
            "role": "omp.welcome.lockup",
            "align": "center",
            "gap": "md"
          },
          "c": [
            {
              "id": "main.welcome.lockup.glyph",
              "k": "text",
              "p": {
                "text": "✦",
                "key": "glyph",
                "role": "omp.welcome.logo",
                "tone": "accent",
                "title": "Agent"
              }
            },
            {
              "id": "main.welcome.lockup.mark",
              "k": "col",
              "p": {
                "key": "mark",
                "role": "omp.welcome.mark"
              },
              "c": [
                {
                  "id": "main.welcome.lockup.mark.wordmark",
                  "k": "text",
                  "p": {
                    "spans": [
                      {
                        "t": "Agent",
                        "s": "strong"
                      }
                    ],
                    "key": "wordmark",
                    "role": "omp.welcome.wordmark"
                  }
                },
                {
                  "id": "main.welcome.lockup.mark.version",
                  "k": "text",
                  "p": {
                    "spans": [
                      {
                        "t": "Connecting…",
                        "s": "dim mono"
                      }
                    ],
                    "key": "version",
                    "role": "omp.welcome.version"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "main.welcome.tip",
          "k": "row",
          "p": {
            "key": "tip",
            "role": "omp.welcome.tip",
            "gap": "sm",
            "align": "start"
          },
          "c": [
            {
              "id": "main.welcome.tip.icon",
              "k": "icon",
              "p": {
                "name": "folder",
                "key": "icon",
                "role": "omp.welcome.tip-icon"
              }
            },
            {
              "id": "main.welcome.tip.text",
              "k": "text",
              "p": {
                "text": "Starting session…  ·  / commands  ·  @ files",
                "key": "text",
                "role": "omp.welcome.tip-text"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "main.welcome.after",
      "k": "spacer",
      "p": {
        "key": "welcome.after",
        "size": "sm"
      }
    },
    {
      "id": "main.entry.1",
      "k": "col",
      "p": {
        "key": "entry.1",
        "role": "omp.assistant"
      },
      "c": [
        {
          "id": "main.entry.1.body.0",
          "k": "image",
          "p": {
            "key": "body.0",
            "blob": "sha256-image",
            "alt": "Attached image",
            "actions": {
              "click": "zoom"
            }
          }
        },
        {
          "id": "main.entry.1.body.1",
          "k": "section",
          "p": {
            "key": "body.1",
            "head": "file:///src/main.rs",
            "collapsible": true,
            "collapsed": true
          },
          "c": [
            {
              "id": "main.entry.1.body.1.code",
              "k": "code",
              "p": {
                "text": "fn main() {}",
                "key": "code",
                "actions": {
                  "menu": [
                    "copy"
                  ]
                },
                "lang": "rs"
              }
            }
          ]
        },
        {
          "id": "main.entry.1.body.2",
          "k": "md",
          "p": {
            "text": "[source](file:///src/main.rs)",
            "key": "body.2",
            "href": "file:///src/main.rs",
            "actions": {
              "menu": [
                "open",
                "copy"
              ]
            }
          }
        }
      ]
    }
  ]
}
