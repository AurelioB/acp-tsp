---
source: tests/ui_content_view.rs
expression: "wire(&model)[\"main\"]"
---
{
  "id": "main",
  "k": "col",
  "p": {
    "key": "transcript"
  },
  "c": [
    {
      "id": "main.welcome.before",
      "k": "spacer",
      "p": {
        "key": "welcome.before",
        "size": "sm"
      }
    },
    {
      "id": "main.welcome",
      "k": "card",
      "p": {
        "key": "welcome",
        "role": "omp.welcome"
      },
      "c": [
        {
          "id": "main.welcome.lockup",
          "k": "row",
          "p": {
            "key": "lockup",
            "role": "omp.welcome.lockup",
            "align": "center",
            "gap": "md"
          },
          "c": [
            {
              "id": "main.welcome.lockup.glyph",
              "k": "text",
              "p": {
                "text": "✦",
                "key": "glyph",
                "role": "omp.welcome.logo",
                "tone": "accent",
                "title": "Agent"
              }
            },
            {
              "id": "main.welcome.lockup.mark",
              "k": "col",
              "p": {
                "key": "mark",
                "role": "omp.welcome.mark"
              },
              "c": [
                {
                  "id": "main.welcome.lockup.mark.wordmark",
                  "k": "text",
                  "p": {
                    "spans": [
                      {
                        "t": "Agent",
                        "s": "strong"
                      }
                    ],
                    "key": "wordmark",
                    "role": "omp.welcome.wordmark"
                  }
                },
                {
                  "id": "main.welcome.lockup.mark.version",
                  "k": "text",
                  "p": {
                    "spans": [
                      {
                        "t": "Connecting…",
                        "s": "dim mono"
                      }
                    ],
                    "key": "version",
                    "role": "omp.welcome.version"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "main.welcome.tip",
          "k": "row",
          "p": {
            "key": "tip",
            "role": "omp.welcome.tip",
            "gap": "sm",
            "align": "start"
          },
          "c": [
            {
              "id": "main.welcome.tip.icon",
              "k": "icon",
              "p": {
                "name": "folder",
                "key": "icon",
                "role": "omp.welcome.tip-icon"
              }
            },
            {
              "id": "main.welcome.tip.text",
              "k": "text",
              "p": {
                "text": "Starting session…  ·  / commands  ·  @ files",
                "key": "text",
                "role": "omp.welcome.tip-text"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "main.welcome.after",
      "k": "spacer",
      "p": {
        "key": "welcome.after",
        "size": "sm"
      }
    },
    {
      "id": "main.entry.1",
      "k": "tool",
      "p": {
        "name": "generic",
        "key": "entry.1",
        "role": "omp.tool.generic",
        "title": "Tests",
        "status": "pending",
        "frame": "inline",
        "collapsible": false,
        "collapsed": false,
        "age": 0
      },
      "c": [
        {
          "id": "main.entry.1.0",
          "k": "section",
          "p": {
            "key": "0",
            "head": "cargo test",
            "collapsible": true
          },
          "c": [
            {
              "id": "main.entry.1.0.status",
              "k": "badge",
              "p": {
                "text": "Running",
                "key": "status"
              }
            },
            {
              "id": "main.entry.1.0.output",
              "k": "ansi",
              "p": {
                "text": "\u001b[32mOK\u001b[0m\n",
                "key": "output"
              }
            },
            {
              "id": "main.entry.1.0.kill",
              "k": "el",
              "p": {
                "tag": "button",
                "text": "Kill terminal",
                "key": "kill",
                "actions": {
                  "click": "click"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
