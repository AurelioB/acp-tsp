---
source: tests/ui_view.rs
expression: wire(&model)
---
{
  "main": {
    "id": "main",
    "k": "col",
    "p": {
      "key": "transcript"
    }
  },
  "dock": {
    "id": "dock",
    "k": "col",
    "c": [
      {
        "id": "dock.bar",
        "k": "status",
        "p": {
          "key": "bar"
        },
        "c": [
          {
            "id": "dock.bar.agent",
            "k": "seg",
            "p": {
              "text": "Agent",
              "key": "agent"
            }
          },
          {
            "id": "dock.bar.state",
            "k": "seg",
            "p": {
              "text": "Starting",
              "key": "state"
            }
          }
        ]
      },
      {
        "id": "dock.ed",
        "k": "editor",
        "p": {
          "key": "ed",
          "text": "",
          "cursor": 0,
          "placeholder": "Message (Enter sends · Shift+Enter newline)",
          "readonly": true,
          "sendable": false
        }
      }
    ]
  },
  "layer": {
    "id": "layer",
    "k": "col",
    "c": [
      {
        "id": "layer.permission.sheet",
        "k": "overlay",
        "p": {
          "key": "permission.sheet",
          "anchor": "bottom",
          "size": "lg",
          "modal": true
        },
        "c": [
          {
            "id": "layer.permission.sheet.permission",
            "k": "col",
            "p": {
              "role": "omp.editor",
              "key": "permission"
            },
            "c": [
              {
                "id": "layer.permission.sheet.permission.title",
                "k": "text",
                "p": {
                  "text": "Run tests",
                  "key": "title",
                  "role": "omp.ask.question"
                }
              },
              {
                "id": "layer.permission.sheet.permission.options",
                "k": "list",
                "p": {
                  "key": "options",
                  "role": "omp.ask.options",
                  "selected": "layer.permission.sheet.permission.options.option.0"
                },
                "c": [
                  {
                    "id": "layer.permission.sheet.permission.options.option.0",
                    "k": "item",
                    "p": {
                      "label": "Allow once",
                      "key": "option.0",
                      "role": "omp.ask.option",
                      "hint": [
                        "1"
                      ],
                      "actions": {
                        "click": "click"
                      }
                    }
                  },
                  {
                    "id": "layer.permission.sheet.permission.options.option.1",
                    "k": "item",
                    "p": {
                      "label": "Reject once",
                      "key": "option.1",
                      "role": "omp.ask.option",
                      "hint": [
                        "2"
                      ],
                      "actions": {
                        "click": "click"
                      }
                    }
                  }
                ]
              },
              {
                "id": "layer.permission.sheet.permission.actions",
                "k": "row",
                "p": {
                  "key": "actions",
                  "role": "omp.actions"
                },
                "c": [
                  {
                    "id": "layer.permission.sheet.permission.actions.0",
                    "k": "spacer",
                    "p": {
                      "grow": 1
                    }
                  },
                  {
                    "id": "layer.permission.sheet.permission.actions.cancel",
                    "k": "row",
                    "p": {
                      "key": "cancel",
                      "role": "omp.btn",
                      "actions": {
                        "click": "click"
                      }
                    },
                    "c": [
                      {
                        "id": "layer.permission.sheet.permission.actions.cancel.0",
                        "k": "text",
                        "p": {
                          "text": "Cancel"
                        }
                      },
                      {
                        "id": "layer.permission.sheet.permission.actions.cancel.1",
                        "k": "kbd",
                        "p": {
                          "keys": [
                            "escape"
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
