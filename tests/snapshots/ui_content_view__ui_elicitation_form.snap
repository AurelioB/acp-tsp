---
source: tests/ui_content_view.rs
expression: "wire(&model)[\"layer\"]"
---
{
  "id": "layer",
  "k": "col",
  "c": [
    {
      "id": "layer.elicitation",
      "k": "overlay",
      "p": {
        "anchor": "bottom",
        "size": "lg",
        "key": "elicitation",
        "role": "omp.editor",
        "head": "Agent question"
      },
      "c": [
        {
          "id": "layer.elicitation.message",
          "k": "md",
          "p": {
            "text": "What should I use?",
            "key": "message",
            "role": "omp.ask.question"
          }
        },
        {
          "id": "layer.elicitation.form",
          "k": "el",
          "p": {
            "tag": "form",
            "key": "form"
          },
          "c": [
            {
              "id": "layer.elicitation.form.count",
              "k": "el",
              "p": {
                "tag": "div",
                "key": "count"
              },
              "c": [
                {
                  "id": "layer.elicitation.form.count.label",
                  "k": "el",
                  "p": {
                    "tag": "p",
                    "text": "count",
                    "key": "label"
                  }
                },
                {
                  "id": "layer.elicitation.form.count.field.count",
                  "k": "input",
                  "p": {
                    "key": "field.count",
                    "text": "",
                    "cursor": 0,
                    "placeholder": "count"
                  }
                }
              ]
            },
            {
              "id": "layer.elicitation.form.name",
              "k": "el",
              "p": {
                "tag": "div",
                "key": "name"
              },
              "c": [
                {
                  "id": "layer.elicitation.form.name.label",
                  "k": "el",
                  "p": {
                    "tag": "p",
                    "text": "Your name",
                    "key": "label"
                  }
                },
                {
                  "id": "layer.elicitation.form.name.field.name",
                  "k": "input",
                  "p": {
                    "key": "field.name",
                    "text": "",
                    "cursor": 0,
                    "placeholder": "Your name"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "layer.elicitation.actions",
          "k": "row",
          "p": {
            "key": "actions",
            "role": "omp.actions",
            "gap": "sm"
          },
          "c": [
            {
              "id": "layer.elicitation.actions.0",
              "k": "spacer",
              "p": {
                "grow": 1
              }
            },
            {
              "id": "layer.elicitation.actions.decline",
              "k": "row",
              "p": {
                "key": "decline",
                "role": "omp.btn",
                "gap": "xs",
                "actions": {
                  "click": "click"
                }
              },
              "c": [
                {
                  "id": "layer.elicitation.actions.decline.0",
                  "k": "text",
                  "p": {
                    "text": "Decline"
                  }
                }
              ]
            },
            {
              "id": "layer.elicitation.actions.cancel",
              "k": "row",
              "p": {
                "key": "cancel",
                "role": "omp.btn",
                "gap": "xs",
                "actions": {
                  "click": "click"
                }
              },
              "c": [
                {
                  "id": "layer.elicitation.actions.cancel.0",
                  "k": "text",
                  "p": {
                    "text": "Cancel"
                  }
                },
                {
                  "id": "layer.elicitation.actions.cancel.1",
                  "k": "kbd",
                  "p": {
                    "keys": [
                      "escape"
                    ]
                  }
                }
              ]
            },
            {
              "id": "layer.elicitation.actions.accept",
              "k": "row",
              "p": {
                "key": "accept",
                "role": "omp.btn",
                "gap": "xs",
                "tone": "accent",
                "actions": {
                  "click": "click"
                }
              },
              "c": [
                {
                  "id": "layer.elicitation.actions.accept.0",
                  "k": "text",
                  "p": {
                    "text": "Accept"
                  }
                },
                {
                  "id": "layer.elicitation.actions.accept.1",
                  "k": "kbd",
                  "p": {
                    "keys": [
                      "enter"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
